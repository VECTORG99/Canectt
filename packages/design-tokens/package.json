{
  "name": "@canectt/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Tokens de diseño de Canectt (variables CSS y JSON) consumidos por apps/web.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/tokens.css",
    "./json": "./dist/tokens.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsx src/build.ts",
    "dev": "tsx watch src/build.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "tsx": "^4.19.1",
    "vitest": "^2.1.1"
  }
}
