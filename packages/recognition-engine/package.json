{
  "name": "@canectt/recognition-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Motor de reconocimiento de Canectt: detección de formato por magic bytes, parsers (PDF/Word/Excel/Markdown), reconocedor de patrones de horario y normalizador al esquema canónico.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@canectt/schema": "workspace:*",
    "exceljs": "^4.4.0",
    "mammoth": "^1.8.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unpdf": "^0.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
