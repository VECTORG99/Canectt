# ─── Canectt — variables de entorno ───────────────────────────────────────────
# Copia este archivo a `.env` y completa los valores. NUNCA commitear `.env`.

# ── Backend (apps/api) ────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=8787
API_PUBLIC_URL=http://localhost:8787

# ── Frontend (apps/web) ───────────────────────────────────────────────────────
# URL pública del frontend (para redirects OAuth y CORS).
WEB_PUBLIC_URL=http://localhost:5173

# ── Google OAuth 2.0 (solo escritura en Calendar) ─────────────────────────────
# Obtener en: https://console.cloud.google.com/apis/credentials
# Origen autorizado: ${WEB_PUBLIC_URL}
# Redirect autorizado: ${GOOGLE_REDIRECT_URI}
#
# En desarrollo (Vite proxy): http://localhost:5173/api/auth/google/callback
# En producción (docker-compose, Caddy proxy): http://localhost/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Scopes solicitados (no cambiar sin revisar SECURITY.md)
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/calendar.events

# ── Sesión de servidor (cookie firmada httpOnly, corta duración) ──────────────
# Generar con: `openssl rand -base64 64`
SESSION_SECRET=
SESSION_COOKIE_MAX_AGE_MS=600000
SESSION_COOKIE_NAME=canectt_sid

# ── límites de subida de archivos (no hardcodear en código) ───────────────────
UPLOAD_MAX_BYTES=10485760
UPLOAD_TIMEOUT_MS=30000

# ── Persistencia (Fase 2) ─────────────────────────────────────────────────────
# PostgreSQL via Prisma. Vacío = sin base de datos (las rutas /api/schedules
# responden 503). Para activar:
#   1. docker compose up db
#   2. pnpm --filter @canectt/api prisma:migrate
#   3. Setear DATABASE_URL=postgresql://canectt:PASSWORD@localhost:5432/canectt
DATABASE_URL=
POSTGRES_PASSWORD=

# ── CORS orígenes permitidos (separados por coma) ─────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
