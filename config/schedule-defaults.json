{
  "$schema": "./schedule-defaults.schema.json",
  "editor": {
    "defaultDayRange": { "startTime": "06:00", "endTime": "23:00" },
    "fullDayRange": { "startTime": "00:00", "endTime": "23:59" },
    "snapMinutes": [5, 10, 15, 30],
    "defaultSnapMinutes": 15,
    "defaultBlockDurationMinutes": 30,
    "minBlockDurationMinutes": 5,
    "rowHeightPx": 64,
    "mobileRowHeightPx": 56
  },
  "upload": {
    "maxBytes": 10485760,
    "timeoutMs": 30000,
    "acceptedExtensions": [".pdf", ".docx", ".md", ".xlsx"],
    "scannedPdfThresholdCharsPerPage": 50
  },
  "export": {
    "defaultTimezone": "America/Santiago",
    "defaultRecurrence": "NONE"
  },
  "blockColors": {
    "available": [
      "block-blue",
      "block-purple",
      "block-coral",
      "block-green",
      "block-amber",
      "block-teal"
    ],
    "default": "block-blue"
  }
}
