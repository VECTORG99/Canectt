{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@canectt/schema": ["../../packages/schema/src/index.ts"],
      "@canectt/schema/*": ["../../packages/schema/src/*"],
      "@canectt/config": ["../../packages/config/src/index.ts"],
      "@canectt/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@canectt/export-engine": ["../../packages/export-engine/src/index.ts"],
      "@canectt/export-engine/*": ["../../packages/export-engine/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "vite.config.ts",
    "vitest.config.ts",
    "tailwind.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", "playwright-report", "test-results"]
}
